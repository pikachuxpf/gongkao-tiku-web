# Server
NODE_ENV=production
PORT=5173
MOJUAN_HOST=0.0.0.0
MOJUAN_DB=./storage/mojuan.sqlite

# First administrator. Change this before the first production start.
MOJUAN_ADMIN_USERNAME=fpx
MOJUAN_ADMIN_PASSWORD=123456
MOJUAN_ADMIN_NAME=系统管理员

# Set false for an invite-only deployment after creating accounts.
MOJUAN_ALLOW_REGISTRATION=false
MOJUAN_SESSION_TTL_DAYS=30
# Keep false behind a plain HTTP reverse proxy; set true when HTTPS terminates here.
MOJUAN_COOKIE_SECURE=true

# Optional server-side OpenAI-compatible proxy. The key never reaches browsers.
MOJUAN_AI_ENDPOINT=https://api.openai.com/v1
MOJUAN_AI_MODEL=gpt-4o-mini
MOJUAN_AI_API_KEY=
